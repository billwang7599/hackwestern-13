# Settings for tars_autostart.sh (sourced by sh). On the Pi:
#   cp tars.env.example tars.env && vi tars.env      (deploy.sh never overwrites tars.env)
# Paths: where deploy.sh / `make -C iter1-wasd/pi deploy` put things.
TARS_HOME=/data/home/qnxuser
VISION=$TARS_HOME/vision
LOG_DIR=$TARS_HOME/logs

# Motor server (iter1-wasd/pi/). -b uno -d <serial> for the Uno over USB serial; -b stub to test without hardware.
MOTOR_BIN=$TARS_HOME/tars_motor
MOTOR_ARGS="-b uno -d /dev/serusb1"

# Vision app: python (QNX prebuilt MediaPipe, default) or cpp (qnx/cpp/tars_gesture_cpu, if you built it)
GESTURE_APP=python
# extra args, e.g. "--unit 1" (python) or "--camera_unit=1" (cpp); "--dry-run" to test without driving
# boot straight into pet mode: "--pet" (python and cpp). Otherwise hold the peace sign to cycle modes.
GESTURE_ARGS=""
LEARNED=$VISION/learned.json

# Camera service. Leave empty if your image already starts `sensor` at boot.
# Otherwise paste the EXACT command you used before camera_example3_viewfinder worked, e.g.
#   CAMERA_CMD="sensor -U 521:521 -r /data/share/sensor -c /data/home/qnxuser/usb_camera.conf"
CAMERA_CMD=""

# seconds to wait after boot before starting (USB serial + camera enumerate)
BOOT_DELAY=3
