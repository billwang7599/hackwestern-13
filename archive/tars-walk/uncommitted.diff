--- a/laptop/tars_client.py
+++ b/laptop/tars_client.py
@@ -6,6 +6,8 @@
         t.gesture("wave")     # wave point shrug nod stance fold
         t.arm(0, 45)          # left arm swings 45 deg forward
         t.home()
+        t.walk(3)             # 3 crank steps forward, returns when done
+        t.turn(90)            # turn left 90 deg (multiples of 30), returns when done
         t.stop()
 
 Set TARS_HOST / TARS_PORT env vars to change the default address.
@@ -154,10 +156,57 @@ class Tars:
     def forward(self, seconds: float = 1.0, speed: float = 0.5) -> None:
         self.move_for(speed, speed, seconds)
 
-    def turn(self, seconds: float = 0.6, speed: float = 0.5) -> None:
-        """Positive speed = turn right (spin in place)."""
+    def spin(self, seconds: float = 0.6, speed: float = 0.5) -> None:
+        """Timed spin on the drive motors (wheeled fallback). Positive = right."""
         self.move_for(speed, -speed, seconds)
 
+    # -- walking (crank legs) -------------------------------------------------
+    def walk_start(self, steps: int) -> float:
+        """Start walking (non-blocking). + forward, - back. Returns estimated seconds."""
+        return int(self.send(f"WALK {int(steps)}")) / 1000.0
+
+    def turn_start(self, degrees: int) -> float:
+        """Start a turn in place (non-blocking). Multiple of 30, + = left. Returns est. seconds."""
+        if int(degrees) % 30:
+            raise TarsError(f"TURN must be a multiple of 30 degrees (got {degrees})")
+        return int(self.send(f"TURN {int(degrees)}")) / 1000.0
+
+    def walk_wait(self, est_s: float = 0.0, timeout: float | None = None) -> str:
+        """Block until the current walk/turn ends. Returns walk_last, e.g. 'DONE_W_3'
+        or 'ABORT_W_1_stall'. Raises TarsError on an ABORT."""
+        end = time.monotonic() + (timeout if timeout is not None else est_s * 2 + 3.0)
+        st = self.status()
+        while st.get("walk") != "idle" and time.monotonic() < end:
+            time.sleep(0.05)
+            st = self.status()
+        if st.get("walk") != "idle":
+            self.stop()
+            raise TarsError("walk timed out (stopped)")
+        last = str(st.get("walk_last", ""))
+        if last.startswith("ABORT"):
+            raise TarsError(f"walk aborted: {last}")
+        return last
+
+    def walk(self, steps: int) -> str:
+        """Walk n crank steps and wait for it to finish. Returns e.g. 'DONE_W_3'."""
+        return self.walk_wait(self.walk_start(steps))
+
+    def turn(self, degrees: int) -> str:
+        """Turn in place by a multiple of 30 deg (+ = left) and wait. Returns 'DONE_R_<deg>'."""
+        return self.walk_wait(self.turn_start(degrees))
+
+    def cal(self, *args) -> str:
+        """CAL passthrough: cal() -> current values; cal('DEG', 28.5); cal('MS', 2, 600)."""
+        return self.send(" ".join(["CAL", *map(str, args)]))
+
+    def calibration(self) -> dict:
+        """{'ms': [l, r], 'deg': float, 'mode': int, 'yawsign': int}"""
+        out: dict = {}
+        for kv in self.cal().split():
+            k, _, v = kv.partition("=")
+            out[k] = [int(x) for x in v.split(",")] if k == "ms" else (float(v) if k == "deg" else int(v))
+        return out
+
 
