+def read_key() -> str:
+    """One key; arrow keys come back as 'UP' / 'DOWN' / 'LEFT' / 'RIGHT'."""
+    k = sys.stdin.read(1)
+    if k != "\x1b":
+        return k.lower()
+    if select.select([sys.stdin], [], [], 0.02)[0] and sys.stdin.read(1) == "[":
+        if select.select([sys.stdin], [], [], 0.02)[0]:
+            return ARROWS.get(sys.stdin.read(1), "")
+    return ""
+
+
+def flush_input() -> None:
+    """Drop key-repeat that piled up while a step ran (no surprise extra steps)."""
+    while select.select([sys.stdin], [], [], 0)[0]:
+        sys.stdin.read(1)
+
