+        walk_req_t wreq = req_walk;
+        int wstop = req_walk_stop;
+        char calq[32];
+        memcpy(calq, req_cal, sizeof calq);
+        memset(&req_walk, 0, sizeof req_walk);
+        req_walk_stop = 0;
+        req_cal[0] = '\0';
         req_halt = req_zero = req_level = req_stop_gesture = req_reset = 0;
         req_gesture = NULL;
         req_dev_gesture[0] = '\0';
@@ -279,13 +470,17 @@ static void *control_thread(void *arg)
         int blocked = dist >= 0.0f && dist < OBSTACLE_STOP_M && (tl + tr) > 0.0f;
         int bumped = now < bump_until_ms;
         if (blocked || tipped || bumped) { tl = tr = 0.0f; }
+        /* A walk owns the motors on the co-processor: send the idle D 0 0
+         * (the Uno ignores it during a move) and hard-zero the slew. */
+        int walking = ctl_mv.active || wreq.set;
+        if (walking) { tl = tr = 0.0f; out_l = out_r = 0.0f; }
         estop = wd_tripped || blocked || tipped || bumped;
         estop_why = tipped ? "tipped" : bumped ? "bump" : blocked ? "obstacle"
                   : wd_tripped ? "watchdog" : "none";
         last_dist = dist;
         /* Hard stop on estop (no slew); smooth otherwise. */
-        out_l = estop ? tl : slew(out_l, tl);
-        out_r = estop ? tr : slew(out_r, tr);
+        out_l = estop || walking ? tl : slew(out_l, tl);
+        out_r = estop || walking ? tr : slew(out_r, tr);
         float l = out_l, r = out_r;
         int is_tipped = tipped;
         pthread_mutex_unlock(&lock);
@@ -304,6 +499,19 @@ static void *control_thread(void *arg)
             if (motor->arm_zero) motor->arm_zero();
