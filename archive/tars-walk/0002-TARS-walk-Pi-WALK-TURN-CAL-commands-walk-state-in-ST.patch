+/* Parse a whole number, rejecting "1.5", "3x", "". */
+static int parse_int(const char *s, int *out)
+{
+    char *end;
+    while (*s == ' ' || *s == '\t') s++;
+    long v = strtol(s, &end, 10);
+    if (end == s) return 0;
+    while (*end == ' ' || *end == '\t') end++;
+    if (*end) return 0;
+    *out = (int)v;
+    return 1;
+}
+
+static void handle_walk(char kind, const char *args, char *reply, size_t rlen)
+{
+    int v;
+    const char *why;
+    if (kind == 'W') {
+        if (!parse_int(args, &v) || v == 0 || abs(v) > WALK_MAX_STEPS) {
+            snprintf(reply, rlen, "ERR usage: WALK <steps 1..%d, - = back>\n", WALK_MAX_STEPS);
+            return;
+        }
+    } else {
+        if (!parse_int(args, &v) || v == 0 || abs(v) > TURN_MAX_DEG) {
+            snprintf(reply, rlen, "ERR usage: TURN <deg, multiple of 30, + = left, |deg| <= %d>\n", TURN_MAX_DEG);
+            return;
+        }
+        if (v % 30 != 0) {
+            snprintf(reply, rlen, "ERR TURN must be a multiple of 30 degrees (got %d)\n", v);
+            return;
+        }
+    }
+    if (!motor->walk) { snprintf(reply, rlen, "ERR backend can't walk\n"); return; }
+    pthread_mutex_lock(&lock);
+    feed_watchdog();
+    long long left = bump_until_ms - now_ms();
+    if ((why = motion_refused()) != NULL) {
+        snprintf(reply, rlen, "ERR %s\n", why);
+    } else if (left > 0) {
+        snprintf(reply, rlen, "ERR bumped: paused %lld ms\n", left);
+    } else if (walk_kind || req_walk.set) {
+        snprintf(reply, rlen, "ERR busy: already %s (S stops it)\n", walk_kind == 'R' ? "turning" : "walking");
+    } else {
+        req_walk.set = 1;
+        req_walk.kind = kind;
+        req_walk.val = v;
+        walk_kind = kind;
+        walk_cmd = v;
+        walk_seq++;
+        target_l = target_r = 0.0f;
+        snprintf(walk_last, sizeof walk_last, "running");
+        snprintf(reply, rlen, "OK %d\n", walk_est_ms(kind, v));
+    }
+    pthread_mutex_unlock(&lock);
+}
+
+static void handle_cal(const char *args, char *reply, size_t rlen)
+{
+    char what[16] = "";
+    int a, b;
+    float f;
+    sscanf(args, "%15s", what);
+    if (!what[0]) {
+        pthread_mutex_lock(&lock);
+        snprintf(reply, rlen, "OK ms=%d,%d deg=%.2f mode=%d yawsign=%d\n", cal_ms[0], cal_ms[1],
+                 cal_deg, cal_mode, yaw_sign);
+        pthread_mutex_unlock(&lock);
+        return;
+    }
+    char line[32] = "";
+    if (!strcasecmp(what, "MS")) {
+        if (sscanf(args, "%*s %d %d", &a, &b) != 2 || a < 0 || a > 2 || b < 100 || b > 5000) {
+            snprintf(reply, rlen, "ERR usage: CAL MS <0|1|2> <ms 100..5000>\n");
+            return;
+        }
+        snprintf(line, sizeof line, "K %d %d", a, b);
+    } else if (!strcasecmp(what, "DEG")) {
+        if (sscanf(args, "%*s %f", &f) != 1 || !(f >= 1.0f && f <= 180.0f)) {
+            snprintf(reply, rlen, "ERR usage: CAL DEG <deg per turn step 1..180>\n");
+            return;
+        }
+        snprintf(line, sizeof line, "Y %.2f", f);
+    } else if (!strcasecmp(what, "MODE")) {
+        char m[16] = "";
+        sscanf(args, "%*s %15s", m);
+        if (!strcasecmp(m, "1") || !strcasecmp(m, "switch")) snprintf(line, sizeof line, "M 1");
+        else if (!strcasecmp(m, "0") || !strcasecmp(m, "timed")) snprintf(line, sizeof line, "M 0");
+        else { snprintf(reply, rlen, "ERR usage: CAL MODE <1|switch|0|timed>\n"); return; }
+    } else if (!strcasecmp(what, "COUNTS")) {
+        snprintf(line, sizeof line, "C");
+    } else if (!strcasecmp(what, "YAWSIGN")) {
+        if (sscanf(args, "%*s %d", &a) != 1 || (a != 1 && a != -1)) {
+            snprintf(reply, rlen, "ERR usage: CAL YAWSIGN <1|-1>\n");
+            return;
+        }
+        pthread_mutex_lock(&lock);
+        yaw_sign = a;
+        pthread_mutex_unlock(&lock);
+        snprintf(reply, rlen, "OK\n");
+        return;
+    } else {
+        snprintf(reply, rlen, "ERR usage: CAL [MS|DEG|MODE|COUNTS|YAWSIGN ...]\n");
+        return;
+    }
+    if (!motor->cal) { snprintf(reply, rlen, "ERR backend has no calibration\n"); return; }
+    pthread_mutex_lock(&lock);
+    if (walk_kind) {
+        snprintf(reply, rlen, "ERR busy walking\n");
+    } else {
+        snprintf(req_cal, sizeof req_cal, "%s", line);
+        snprintf(reply, rlen, "OK\n");
+    }
+    pthread_mutex_unlock(&lock);
+}
