+def test_walk_yaw() -> None:
+    print("walk: iPhone yaw correction (stub)")
+    yport = free_port()
+    srv = Server("-b", "stub", "-y", str(yport))
+    c = Client(srv.port)
+    ys = YawSender(yport)
+    try:
+        check(srv.wait_log(r"iPhone yaw on udp"), "yaw listener up")
+        c.cmd("CAL MS 2 200")
+        ys.yaw = 10.0
+        time.sleep(0.2)
+        st = c.status()
+        check(st.get("yaw") == "10.0" and int(st.get("yaw_age", 999)) < 200, f"yaw in STATUS {st}")
+        # TURN 90 but the robot only turns 60: one 30-deg correction step
+        check(c.cmd("TURN 90").startswith("OK"), "TURN 90")
+        time.sleep(0.3)
+        ys.yaw = 70.0
+        check(srv.wait_log(r"err 30\.0\) -> correct 1 step", 2.0), "correction step computed")
+        check(srv.wait_log(r"\[stub\] turn raw 1 steps"), "raw turn step sent")
+        time.sleep(0.05)
+        check(c.status()["walk"] == "turn", "still turning during correction")
+        ys.yaw = 101.0
+        st = wait_walk_idle(c, 2.0)
+        check(st["walk_last"] == "DONE_R_90" and st.get("yaw_err") == "-1.0", f"corrected {st}")
+        # over-turn the other way with yaw sign flipped: phone yaw decreases when turning left
+        check(c.cmd("CAL YAWSIGN -1") == "OK", "YAWSIGN -1")
+        ys.yaw = 0.0
+        time.sleep(0.1)
+        c.cmd("TURN -60")          # right turn: yaw*sign should go -60; phone reports +90 => -90
+        time.sleep(0.2)
+        ys.yaw = 90.0
+        check(srv.wait_log(r"yaw says -90\.0 of -60 deg \(err 30\.0\) -> correct 1 step", 2.0), "sign-flipped correction")
+        ys.yaw = 61.0
+        st = wait_walk_idle(c, 2.0)
+        check(st["walk_last"] == "DONE_R_-60", f"done {st}")
+        # wildly wrong yaw: at most 2 corrections, then report
+        c.cmd("CAL YAWSIGN 1")
+        ys.yaw = 0.0
+        time.sleep(0.1)
+        n0 = len(srv.log)
+        c.cmd("TURN 30")
+        st = wait_walk_idle(c, 3.0)
+        fixes = sum("turn raw" in l for l in srv.log[n0:])
+        check(fixes == 2 and st["walk_last"] == "DONE_R_30", f"max 2 corrections ({fixes}) {st}")
+        # stale yaw: no correction
+        ys.close()
+        time.sleep(0.7)
+        n0 = len(srv.log)
+        c.cmd("TURN 30")
+        st = wait_walk_idle(c, 2.0)
+        check(st["walk_last"] == "DONE_R_30" and not any("turn raw" in l for l in srv.log[n0:]), "stale yaw ignored")
+    finally:
+        ys.close()
+        c.close()
+    check(srv.stop() == 0, "yaw stub exit")
