+/* ------------------------------------------------------------------ iPhone yaw */
+static void *yaw_thread(void *arg)
+{
+    int fd = (int)(long)arg;
+    char buf[256];
+    while (running) {
+        fd_set rf;
+        FD_ZERO(&rf);
+        FD_SET(fd, &rf);
+        struct timeval tv = { 0, 200000 };
+        if (select(fd + 1, &rf, NULL, NULL, &tv) <= 0) continue;
+        ssize_t n = recv(fd, buf, sizeof buf - 1, 0);
+        if (n <= 0) continue;
+        buf[n] = '\0';
+        float y;
+        if (sscanf(buf, "YAW %f", &y) == 1 && !isnan(y)) {
+            pthread_mutex_lock(&lock);
+            yaw_deg = y;
+            yaw_ms = now_ms();
+            pthread_mutex_unlock(&lock);
+        }
+    }
+    close(fd);
+    return NULL;
+}
