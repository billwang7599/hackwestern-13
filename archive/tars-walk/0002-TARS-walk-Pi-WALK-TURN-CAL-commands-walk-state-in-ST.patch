+static void yaw_start(void)
+{
+    int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    struct sockaddr_in a;
+    memset(&a, 0, sizeof a);
+    a.sin_family = AF_INET;
+    a.sin_addr.s_addr = htonl(INADDR_ANY);
+    a.sin_port = htons((unsigned short)cfg_yaw_port);
+    if (fd < 0 || bind(fd, (struct sockaddr *)&a, sizeof a) < 0) {
+        perror("yaw udp bind");
+        if (fd >= 0) close(fd);
+        return;
+    }
+    pthread_t t;
+    if (pthread_create(&t, NULL, yaw_thread, (void *)(long)fd) == 0) pthread_detach(t);
+    fprintf(stderr, "tars_motor: iPhone yaw on udp %d\n", cfg_yaw_port);
+}
