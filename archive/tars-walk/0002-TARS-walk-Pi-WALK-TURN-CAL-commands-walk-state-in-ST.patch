+class YawSender:
+    """Plays the iPhone bridge: sends 'YAW <deg>' at 50 Hz."""
+    def __init__(self, port: int):
+        self.port, self.yaw, self._run = port, 0.0, True
+        self.s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        self._t = threading.Thread(target=self._loop, daemon=True)
+        self._t.start()
+
+    def _loop(self) -> None:
+        while self._run:
+            self.s.sendto(f"YAW {self.yaw:.2f}".encode(), ("127.0.0.1", self.port))
+            time.sleep(0.02)
+
+    def close(self) -> None:
+        self._run = False
+        self._t.join(1)
+        self.s.close()
+
