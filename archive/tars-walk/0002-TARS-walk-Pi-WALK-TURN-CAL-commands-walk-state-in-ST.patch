+/* ---- walking (control thread) ---- */
+static struct {
+    int active;
+    char kind;            /* 'W' | 'R' */
+    int cmd;
+    long long deadline;
+    int fixes;            /* yaw correction turns sent */
+    int yaw_ok;
+    float yaw_start;
+} ctl_mv;
+
+static float wrap180(float a)
+{
+    while (a > 180.0f) a -= 360.0f;
+    while (a <= -180.0f) a += 360.0f;
+    return a;
+}
+
+/* Fresh iPhone yaw, signed so + = turned left. 0 = none. Takes `lock`. */
+static int yaw_now(float *out)
+{
+    pthread_mutex_lock(&lock);
+    int ok = yaw_ms && now_ms() - yaw_ms <= YAW_FRESH_MS;
+    *out = yaw_deg * (float)yaw_sign;
+    pthread_mutex_unlock(&lock);
+    return ok;
+}
+
+static int walk_est_ms(char kind, int val)
+{
+    int steps = kind == 'W' ? abs(val) : (int)lroundf(fabsf((float)val) / cal_deg);
+    if (steps < 1) steps = 1;
+    int ms = cal_ms[0] > cal_ms[1] ? cal_ms[0] : cal_ms[1];
+    return steps * ms;
+}
+
+static void ctl_walk_finish(const char *result, int ok)
+{
+    pthread_mutex_lock(&lock);
+    snprintf(walk_last, sizeof walk_last, "%s", result);
+    walk_kind = 0;
+    if (ok) walks_done++;
+    pthread_mutex_unlock(&lock);
+    fprintf(stderr, "[ctl] walk: %s\n", result);
+    ctl_mv.active = 0;
+}
+
+static void ctl_walk_start(char kind, int val, long long now)
+{
+    memset(&ctl_mv, 0, sizeof ctl_mv);
+    ctl_mv.active = 1;
+    ctl_mv.kind = kind;
+    ctl_mv.cmd = val;
+    ctl_mv.deadline = now + 2LL * walk_est_ms(kind, val) + WALK_TIMEOUT_PAD_MS;
+    if (kind == 'R') ctl_mv.yaw_ok = yaw_now(&ctl_mv.yaw_start);
+    fprintf(stderr, "[ctl] walk: %s %d start (~%d ms)%s\n", kind == 'W' ? "WALK" : "TURN", val,
+            walk_est_ms(kind, val), kind == 'R' && ctl_mv.yaw_ok ? " yaw-corrected" : "");
+    if (kind == 'W' && motor->walk) motor->walk(val);
+    if (kind == 'R' && motor->turn) motor->turn(val);
+}
+
+/* A TURN (or one of its correction steps) finished. Correct with the iPhone
+ * yaw if we have it, else report done. */
+static void ctl_turn_done(long long now)
+{
+    char res[40];
+    float y;
+    if (ctl_mv.yaw_ok && yaw_now(&y)) {
+        float actual = wrap180(y - ctl_mv.yaw_start);
+        if (abs(ctl_mv.cmd) >= 360) actual += 360.0f * (float)(ctl_mv.cmd / 360);  /* full turns */
+        float err = wrap180((float)ctl_mv.cmd - actual);
+        int steps = (int)lroundf(err / cal_deg);
+        pthread_mutex_lock(&lock);
+        yaw_err = err;
+        yaw_err_valid = 1;
+        pthread_mutex_unlock(&lock);
+        if (steps != 0 && ctl_mv.fixes < YAW_MAX_FIXES && motor->turn_steps) {
+            ctl_mv.fixes++;
+            ctl_mv.deadline = now + 2LL * abs(steps) * (cal_ms[0] > cal_ms[1] ? cal_ms[0] : cal_ms[1])
+                              + WALK_TIMEOUT_PAD_MS;
+            fprintf(stderr, "[ctl] walk: yaw says %.1f of %d deg (err %.1f) -> correct %d step(s)\n",
+                    actual, ctl_mv.cmd, err, steps);
+            motor->turn_steps(steps);
+            return;
+        }
+        fprintf(stderr, "[ctl] walk: yaw says %.1f of %d deg (err %.1f)\n", actual, ctl_mv.cmd, err);
+    }
+    snprintf(res, sizeof res, "DONE_R_%d", ctl_mv.cmd);
+    ctl_walk_finish(res, 1);
+}
+
+static void ctl_walk_event(const motor_event_t *ev, long long now)
+{
+    char res[40];
+    if (ev->kind == MOTOR_EV_CAL) {
+        pthread_mutex_lock(&lock);
+        cal_ms[0] = ev->cal_ms[0];
+        cal_ms[1] = ev->cal_ms[1];
+        cal_deg = ev->cal_deg > 0.5f ? ev->cal_deg : 30.0f;
+        cal_mode = ev->cal_mode;
+        pthread_mutex_unlock(&lock);
+        fprintf(stderr, "[ctl] cal: ms=%d,%d deg/step=%.2f mode=%s\n", ev->cal_ms[0], ev->cal_ms[1],
+                ev->cal_deg, ev->cal_mode ? "switch" : "timed");
+        return;
+    }
+    if (!ctl_mv.active) {
+        fprintf(stderr, "[ctl] walk: stray %s %c %d (no move active)\n",
+                ev->kind == MOTOR_EV_DONE ? "DONE" : "ABORT", ev->move, ev->value);
+        return;
+    }
+    if (ev->kind == MOTOR_EV_ABORT) {
+        if (!strcmp(ev->why, "new")) return;   /* we replaced it ourselves */
+        snprintf(res, sizeof res, "ABORT_%c_%d_%s", ev->move, ev->value, ev->why);
+        ctl_walk_finish(res, 0);
+        return;
+    }
+    /* DONE */
+    if (ctl_mv.kind == 'W' && ev->move == 'W') {
+        snprintf(res, sizeof res, "DONE_W_%d", ev->value);
+        ctl_walk_finish(res, 1);
+    } else if (ctl_mv.kind == 'R' && (ev->move == 'R' || ev->move == 'Q')) {
+        ctl_turn_done(now);
+    }
+}
+
+static void ctl_walk_tick(long long now)
+{
+    if (ctl_mv.active && now > ctl_mv.deadline) {
+        if (motor->walk_stop) motor->walk_stop();
+        ctl_walk_finish(ctl_mv.kind == 'W' ? "ABORT_W_?_timeout" : "ABORT_R_?_timeout", 0);
+    }
+}
+
 static void ctl_event(const motor_event_t *ev, long long now)
 {
     switch (ev->kind) {
@@ -204,6 +377,11 @@ static void ctl_event(const motor_event_t *ev, long long now)
             fprintf(stderr, "[ctl] TIPPED (%d deg) -> stop, latched until RESET\n", ev->value);
             ctl_gesture_stop("cancelled (tipped)");
             ctl_halt_arms();
+            /* the Uno aborts its own move on a tip (ABORT ... tip); make sure */
+            if (ctl_mv.active) {
