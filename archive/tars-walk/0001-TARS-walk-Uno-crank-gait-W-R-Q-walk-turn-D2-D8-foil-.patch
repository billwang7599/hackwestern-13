+// Host mock of the AVR EEPROM library: 1 KB, starts erased (0xFF) like a new Uno.
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+struct MockEEPROM {
+  uint8_t mem[1024];
+  MockEEPROM() { erase(); }
+  void erase() { memset(mem, 0xFF, sizeof mem); }
+  template <typename T> T &get(int addr, T &t) { memcpy(&t, mem + addr, sizeof(T)); return t; }
