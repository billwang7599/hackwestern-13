+// Crank revolution switches (same in both driver modes). Two strips of foil:
+// one to GND, one to the pin; a foil tab on the crank shorts them once per rev.
+// INPUT_PULLUP, so closed = LOW. D2 = left crank, D8 = right crank.
+const uint8_t PIN_CRANK_SW[2] = {2, 8};
+
 const uint8_t PIN_ARM[2][4] = {
   {A0, A1, A2, A3},             // arm 0: ULN2003 #0 IN1..IN4
   {4, 5, 6, 7},                 // arm 1: ULN2003 #1 IN1..IN4
@@ -103,6 +129,27 @@ const float DRIVE_MIN_DUTY = 0.0f;
 const bool  BRAKE_ON_STOP  = true;   // short-brake on stop/watchdog vs coast
 const uint16_t DRIVE_WATCHDOG_MS = 200;
 
+// ---- Walking ----------------------------------------------------------------------
+const float    WALK_DUTY          = 0.80f;  // crank duty while walking
+const float    TURN_DUTY          = 0.80f;  // crank duty while turning in place
+const float    SYNC_SLOW          = 0.50f;  // duty factor for the side that's a pulse ahead
+const uint8_t  PULSES_PER_STEP    = 1;      // switch closures per step (1 tab per crank rev)
+const uint16_t SW_RELEASE_MS      = 5;      // switch must read open this long before a new pulse
+const uint16_t SW_LOCKOUT_MIN_MS  = 60;     // and at least this long since the last pulse ...
+const float    SW_LOCKOUT_FRAC    = 0.3f;   // ... or this fraction of ms-per-pulse, whichever is longer
+const float    STALL_FACTOR       = 2.0f;   // no pulse for this x ms-per-pulse = stalled
+const uint16_t STALL_MIN_MS       = 400;
+const int16_t  MAX_MOVE_STEPS     = 100;
+const int16_t  MAX_TURN_DEG       = 720;
+const uint16_t MOVE_TELEMETRY_MS  = 250;    // "# mv ..." progress lines
+// Calibration defaults (overwritten from EEPROM once K / Y / M have been sent):
+const uint16_t DEFAULT_MS_PER_STEP     = 600;    // one crank rev at ~100 RPM
+const float    DEFAULT_DEG_PER_TURN_STEP = 30.0f;  // measure: R 360, see calibrate_walk.py
+const uint8_t  DEFAULT_COUNT_MODE      = 1;      // 1 = switches, 0 = timed
+// Rock counting (accelerometer sanity check, reported, never acted on):
+const float    ROCK_HI_DEG        = 4.0f;   // tilt above this ...
+const float    ROCK_LO_DEG        = 2.0f;   // ... then back below this = one rock
+
 // ---- Arms (28BYJ-48 + ULN2003) --------------------------------------------------
 // Half-step mode: 4096 half-steps per output revolution (4076 on some units).
 const float    ARM_STEPS_PER_REV = 4096.0f;
@@ -162,6 +209,9 @@ bool accelInit();
 bool accelRead(int16_t *ax, int16_t *ay, int16_t *az);
 void accelPoll();
 void captureUpright();
+void movePoll();
+void moveAbort(const char *why);
+void crankPoll();
 
 // ---- State ----------------------------------------------------------------------
 static char     lineBuf[40];
@@ -207,6 +257,45 @@ static uint16_t bumpPeakMg = 0;
 static uint32_t lastBumpMs = 0;
 static bool     bumpEverSent = false;
 
+// ---- Walking state ---------------------------------------------------------------
+#define MV_IDLE 0
+#define MV_WALK 1
+#define MV_TURN 2
+#define MV_RAW  3          // Q: raw turn steps
+#define CAL_MAGIC 0x7A52
+struct Cal {
+  uint16_t magic;
+  uint16_t msPerStep[2];
+  float    degPerTurnStep;
+  uint8_t  countMode;
+};
+static Cal cal;
+
+struct Crank {
+  bool     closed;          // debounced: true = contact made
+  uint32_t openSinceMs;     // when the raw pin last went open (0 = closed now)
+  uint32_t lastPulseMs;
+  long     pulses;          // all-time closures (for C and hand-turn tests)
+};
+static Crank cranks[2];
+
+struct Move {
+  uint8_t  kind;            // MV_*
+  int16_t  cmd;             // what was asked: steps (W/Q) or degrees (R)
+  int8_t   dir[2];          // +1 / -1 per side
+  uint16_t target;          // steps per side
+  long     startPulses[2];
+  long     seenPulses[2];
+  uint16_t done[2];
+  bool     sideDone[2];
+  uint32_t startMs;
+  uint32_t lastProgressMs[2];
+  uint32_t lastTelemetryMs;
+};
+static Move mv;
+static uint16_t rocks = 0;
+static bool     rockHigh = false;
+
 // ---- Drive motors ---------------------------------------------------------------
 static uint8_t dutyToPwm(float d) {
   if (d < 0) d = -d;
@@ -329,6 +418,209 @@ void armPoll(uint8_t i) {
   if (a.pos == a.target) a.arrivedMs = millis();
 }
 
+// ---- Calibration (EEPROM) ---------------------------------------------------------
+static void printCal() {
+  Serial.print(F("CAL "));
+  Serial.print((long)cal.msPerStep[0]);
+  Serial.print(F(" "));
+  Serial.print((long)cal.msPerStep[1]);
+  Serial.print(F(" "));
+  Serial.print((long)lround(cal.degPerTurnStep * 100.0f) / 100);
+  Serial.print(F("."));
+  long frac = lround(cal.degPerTurnStep * 100.0f) % 100;
+  if (frac < 10) Serial.print(F("0"));
+  Serial.print(frac);
+  Serial.print(F(" "));
+  Serial.println((int)cal.countMode);
+}
+
+static void calDefaults() {
+  cal.magic = CAL_MAGIC;
+  cal.msPerStep[0] = cal.msPerStep[1] = DEFAULT_MS_PER_STEP;
+  cal.degPerTurnStep = DEFAULT_DEG_PER_TURN_STEP;
+  cal.countMode = DEFAULT_COUNT_MODE;
+}
+
+static void calLoad() {
+  EEPROM.get(0, cal);
+  bool ok = cal.magic == CAL_MAGIC && cal.countMode <= 1 &&
+            cal.msPerStep[0] >= 100 && cal.msPerStep[0] <= 5000 &&
+            cal.msPerStep[1] >= 100 && cal.msPerStep[1] <= 5000 &&
+            cal.degPerTurnStep >= 1.0f && cal.degPerTurnStep <= 180.0f;
+  if (!ok) calDefaults();
+}
+
+static void calSave() { EEPROM.put(0, cal); }
+
+// ---- Crank switches -----------------------------------------------------------------
+static uint32_t msPerPulse(uint8_t side) {
+  return cal.msPerStep[side] / PULSES_PER_STEP;
+}
+
+// Count a pulse on open -> closed, if the contact had been open for
+// SW_RELEASE_MS (contact bounce) and the lockout since the last pulse is over
+// (a wobbly crank tab brushing the foil twice).
+void crankPoll() {
+  uint32_t now = millis();
+  for (uint8_t i = 0; i < 2; i++) {
+    Crank &c = cranks[i];
+    bool rawClosed = digitalRead(PIN_CRANK_SW[i]) == LOW;
+    if (!rawClosed) {
+      if (!c.openSinceMs) c.openSinceMs = now ? now : 1;
+      if (c.closed && (uint32_t)(now - c.openSinceMs) >= SW_RELEASE_MS) c.closed = false;
+      continue;
+    }
+    bool wasOpenLongEnough = c.openSinceMs && (uint32_t)(now - c.openSinceMs) >= SW_RELEASE_MS;
+    c.openSinceMs = 0;
+    if (c.closed || !wasOpenLongEnough) continue;
+    c.closed = true;
+    uint32_t lockout = (uint32_t)(msPerPulse(i) * SW_LOCKOUT_FRAC);
+    if (lockout < SW_LOCKOUT_MIN_MS) lockout = SW_LOCKOUT_MIN_MS;
+    if (c.pulses && (uint32_t)(now - c.lastPulseMs) < lockout) continue;
+    c.pulses++;
+    c.lastPulseMs = now;
+  }
+}
+
+// ---- Moves (walk / turn) --------------------------------------------------------------
+static const char *moveLetter(uint8_t kind) {
+  return kind == MV_WALK ? "W" : kind == MV_TURN ? "R" : "Q";
+}
+
+static long moveDoneSteps() {
+  return mv.done[0] < mv.done[1] ? mv.done[0] : mv.done[1];
+}
+
+// What to report as "done" for this move: signed steps, or degrees for R.
+static long moveDoneValue() {
+  long s = moveDoneSteps();
+  if (mv.kind == MV_TURN) {
+    long deg = lround(s * cal.degPerTurnStep);
+    return mv.cmd < 0 ? -deg : deg;
+  }
+  return mv.cmd < 0 ? -s : s;
+}
+
+static void moveEnd() {
+  mv.kind = MV_IDLE;
+  driveStop();
+  Serial.print(F("# rocks "));
+  Serial.println((long)rocks);
+}
+
+void moveAbort(const char *why) {
+  if (mv.kind == MV_IDLE) return;
+  Serial.print(F("ABORT "));
+  Serial.print(moveLetter(mv.kind));
+  Serial.print(F(" "));
+  Serial.print(moveDoneValue());
+  Serial.print(F(" "));
+  Serial.println(why);
+  moveEnd();
+}
+
+static void moveStart(uint8_t kind, int16_t cmd, int8_t dirL, int8_t dirR, uint16_t steps) {
+  if (mv.kind != MV_IDLE) moveAbort("new");
+  driveActive = false;           // a move owns the motors; the D watchdog is out of it
+  mv = Move();
+  mv.kind = kind;
+  mv.cmd = cmd;
+  mv.dir[0] = dirL;
+  mv.dir[1] = dirR;
+  mv.target = steps;
+  uint32_t now = millis();
+  mv.startMs = now;
+  mv.lastTelemetryMs = now;
+  for (uint8_t i = 0; i < 2; i++) {
+    mv.startPulses[i] = mv.seenPulses[i] = cranks[i].pulses;
+    mv.lastProgressMs[i] = now;
+  }
+  rocks = 0;
+  rockHigh = tiltDeg > ROCK_HI_DEG;
+  if (tipped) { moveAbort("tip"); return; }
+  movePoll();
+}
+
+static void rockPoll() {
+  if (mv.kind == MV_IDLE || !accelAddr) return;
+  if (!rockHigh && tiltDeg > ROCK_HI_DEG) rockHigh = true;
+  else if (rockHigh && tiltDeg < ROCK_LO_DEG) { rockHigh = false; rocks++; }
+}
+
+void movePoll() {
+  if (mv.kind == MV_IDLE) return;
+  uint32_t now = millis();
+  float base = mv.kind == MV_WALK ? WALK_DUTY : TURN_DUTY;
+
+  for (uint8_t i = 0; i < 2; i++) {
+    if (cal.countMode == 1) {
+      if (cranks[i].pulses != mv.seenPulses[i]) {
+        mv.seenPulses[i] = cranks[i].pulses;
+        mv.lastProgressMs[i] = now;
+      }
+      long p = (cranks[i].pulses - mv.startPulses[i]) / PULSES_PER_STEP;
+      mv.done[i] = p > mv.target ? mv.target : (uint16_t)p;
+    } else {
+      uint32_t el = now - mv.startMs;
+      uint32_t s = el / cal.msPerStep[i];
+      mv.done[i] = s > mv.target ? mv.target : (uint16_t)s;
+    }
+    mv.sideDone[i] = mv.done[i] >= mv.target;
+  }
+
+  // Stall: a side that should be turning hasn't closed its switch in time.
+  if (cal.countMode == 1) {
+    for (uint8_t i = 0; i < 2; i++) {
+      if (mv.sideDone[i]) continue;
+      uint32_t limit = (uint32_t)(STALL_FACTOR * msPerPulse(i));
+      if (limit < STALL_MIN_MS) limit = STALL_MIN_MS;
+      if ((uint32_t)(now - mv.lastProgressMs[i]) > limit) {
+        Serial.print(F("# stall "));
+        Serial.println(i == 0 ? F("left") : F("right"));
+        moveAbort("stall");
+        return;
+      }
+    }
+  }
+
+  if (mv.sideDone[0] && mv.sideDone[1]) {
+    Serial.print(F("DONE "));
+    Serial.print(moveLetter(mv.kind));
+    Serial.print(F(" "));
+    Serial.println((long)mv.cmd);
+    moveEnd();
+    return;
+  }
+
+  // Keep the sides together: the one that's ahead (in pulses) slows down.
+  long pl = cranks[0].pulses - mv.startPulses[0];
+  long pr = cranks[1].pulses - mv.startPulses[1];
+  for (uint8_t i = 0; i < 2; i++) {
+    float duty = 0.0f;
+    if (!mv.sideDone[i]) {
+      duty = base;
+      if (cal.countMode == 1 && ((i == 0 && pl > pr) || (i == 1 && pr > pl))) duty *= SYNC_SLOW;
+    }
+    bool inv = i == 0 ? LEFT_INVERT : RIGHT_INVERT;
+    float out = duty * mv.dir[i];
+    motorWrite(i, inv ? -out : out, BRAKE_ON_STOP);
+  }
+
+  if ((uint32_t)(now - mv.lastTelemetryMs) >= MOVE_TELEMETRY_MS) {
+    mv.lastTelemetryMs = now;
+    Serial.print(F("# mv "));
+    Serial.print(moveLetter(mv.kind));
+    Serial.print(F(" L "));
+    Serial.print((long)mv.done[0]);
+    Serial.print(F(" R "));
+    Serial.print((long)mv.done[1]);
+    Serial.print(F(" / "));
+    Serial.println((long)mv.target);
+  }
+}
+
+static bool isWhole(float v) { return v == (float)(long)v; }
+
 // ---- Parsing ----------------------------------------------------------------------
 static const char *skipSpace(const char *s) {
