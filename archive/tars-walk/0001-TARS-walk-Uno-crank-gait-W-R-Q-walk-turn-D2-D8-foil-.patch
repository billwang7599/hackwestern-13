+// ---------------------------------------------------------------- walking
+static bool has(const char *needle) { return Serial.out.find(needle) != std::string::npos; }
+// Run until the needle shows up (or timeout). Returns ms taken, -1 on timeout.
+static int runUntil(const char *needle, uint32_t timeoutMs) {
+  for (uint32_t t = 0; t < timeoutMs; t += 5) { if (has(needle)) return (int)t; run(5); }
+  return has(needle) ? (int)timeoutMs : -1;
+}
+static void bootWalk(bool withMpu = false) {
